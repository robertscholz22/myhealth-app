# TestFlight upload (P23), run by the `testflight` job of .github/workflows/ios.yml on a macOS
# runner. Needs an App Store Connect API key (ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8) and the team
# id (APPLE_TEAM_ID). The App ID (with HealthKit) and the app record must exist in the account.
default_platform(:ios)

BUNDLE_ID = "io.github.robertscholz22.myhealth"

platform :ios do
  lane :beta do
    setup_ci
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
    )

    # A runner starts without the private key of earlier certificates, and an account holds only a
    # few distribution certificates: the ones made here before are revoked, then one is created.
    # Builds already on TestFlight keep working.
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**api_key.slice(:key_id, :issuer_id, :key))
    Spaceship::ConnectAPI::Certificate.all
      .select { |c| c.certificate_type.to_s.include?("DISTRIBUTION") }
      .each { |c| UI.message("Revoking #{c.name} (#{c.id})"); c.delete! }

    cert(api_key: api_key, generate_apple_certs: true)
    sigh(api_key: api_key, app_identifier: BUNDLE_ID, force: true)
    profile = lane_context[SharedValues::SIGH_NAME]

    update_code_signing_settings(
      path: "MyHealth.xcodeproj",
      targets: ["MyHealth"],
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      bundle_identifier: BUNDLE_ID,
      profile_name: profile,
      code_sign_identity: "Apple Distribution",
    )
    build_app(
      project: "MyHealth.xcodeproj",
      scheme: "MyHealth",
      configuration: "Release",
      export_method: "app-store",
      export_options: { provisioningProfiles: { BUNDLE_ID => profile } },
      xcargs: "MARKETING_VERSION=#{ENV.fetch('VERSION_NAME')} CURRENT_PROJECT_VERSION=#{ENV.fetch('VERSION_CODE')}",
      output_directory: "build",
    )
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
