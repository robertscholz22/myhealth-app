# TestFlight upload (P23), run by the `testflight` job of .github/workflows/ios.yml on a macOS
# runner. Needs an App Store Connect API key (ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8) and the team
# id (APPLE_TEAM_ID). The App ID (with HealthKit) and the app record must exist in the account.
default_platform(:ios)

BUNDLE_ID = "io.github.robertscholz22.myhealth"
# P26.8: the share extension and the App Group both targets use. Building without the extension
# (workflow input share_extension=false) strips it from project.yml before this lane runs.
SHARE_ID = "io.github.robertscholz22.myhealth.share"
APP_GROUP = "group.io.github.robertscholz22.myhealth"

# The API creates App IDs and switches capabilities on, but cannot create an App Group or add an
# App ID to one: that stays a one-time step in the developer portal, checked here per profile.
def ensure_share_ids!
  unless Spaceship::ConnectAPI::BundleId.find(SHARE_ID)
    UI.message("Creating App ID #{SHARE_ID}")
    Spaceship::ConnectAPI::BundleId.create(name: "MyHealth Share", platform: "IOS", identifier: SHARE_ID)
  end
  [BUNDLE_ID, SHARE_ID].each do |id|
    bundle = Spaceship::ConnectAPI::BundleId.find(id)
    next if bundle.get_capabilities.any? { |c| c.capability_type.to_s == "APP_GROUPS" }
    UI.message("Enabling App Groups for #{id}")
    bundle.create_capability(Spaceship::ConnectAPI::BundleIdCapability::Type::APP_GROUPS)
  end
end

def check_app_group!(profile_path, id)
  plist = `security cms -D -i "#{profile_path}"`
  return if plist.include?(APP_GROUP)
  UI.user_error!(
    "The profile for #{id} has no App Group #{APP_GROUP}. One-time step in the developer portal: " \
    "Identifiers > App Groups > + > #{APP_GROUP}; then Identifiers > #{id} > App Groups > Configure > " \
    "tick it > Save (for both #{BUNDLE_ID} and #{SHARE_ID}). Or run the workflow with share_extension=false.",
  )
end

platform :ios do
  lane :beta do
    setup_ci
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
    )

    # A runner starts without the private key of earlier certificates, and an account holds only a
    # few distribution certificates: the ones made here before are revoked, then one is created.
    # Builds already on TestFlight keep working.
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**api_key.slice(:key_id, :issuer_id, :key))
    Spaceship::ConnectAPI::Certificate.all
      .select { |c| c.certificate_type.to_s.include?("DISTRIBUTION") }
      .each { |c| UI.message("Revoking #{c.name} (#{c.id})"); c.delete! }

    # Into setup_ci's temporary keychain (empty password); cert would use the login keychain,
    # which is locked on a runner, and then not find the identity it just made.
    keychain = File.expand_path("~/Library/Keychains/fastlane_tmp_keychain-db")
    # setup_ci's keychain locks itself after an hour; the Kotlin release framework alone can take
    # that long, and codesign then waits for an unlock that never comes (run 43615701757).
    sh("security", "set-keychain-settings", "-t", "21600", keychain)
    cert(api_key: api_key, generate_apple_certs: true, keychain_path: keychain, keychain_password: "")
    # Ruby in a lane runs inside fastlane/, actions run in iosApp/ — look in both (run 44944626378).
    spec = ["../project.yml", "project.yml"].find { |p| File.exist?(p) } or UI.user_error!("project.yml not found")
    share = File.read(spec).include?("MyHealthShare:")
    ensure_share_ids! if share
    sigh(api_key: api_key, app_identifier: BUNDLE_ID, force: true)
    profile = lane_context[SharedValues::SIGH_NAME]
    profiles = { BUNDLE_ID => profile }
    if share
      check_app_group!(lane_context[SharedValues::SIGH_PROFILE_PATH], BUNDLE_ID)
      sigh(api_key: api_key, app_identifier: SHARE_ID, force: true)
      profiles[SHARE_ID] = lane_context[SharedValues::SIGH_NAME]
      check_app_group!(lane_context[SharedValues::SIGH_PROFILE_PATH], SHARE_ID)
      update_code_signing_settings(
        path: "MyHealth.xcodeproj",
        targets: ["MyHealthShare"],
        use_automatic_signing: false,
        team_id: ENV.fetch("APPLE_TEAM_ID"),
        bundle_identifier: SHARE_ID,
        profile_name: profiles[SHARE_ID],
        code_sign_identity: "Apple Distribution",
      )
    end

    update_code_signing_settings(
      path: "MyHealth.xcodeproj",
      targets: ["MyHealth"],
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      bundle_identifier: BUNDLE_ID,
      profile_name: profile,
      code_sign_identity: "Apple Distribution",
    )
    build_app(
      project: "MyHealth.xcodeproj",
      scheme: "MyHealth",
      configuration: "Release",
      export_method: "app-store",
      export_options: { provisioningProfiles: profiles },
      xcargs: "MARKETING_VERSION=#{ENV.fetch('VERSION_NAME')} CURRENT_PROJECT_VERSION=#{ENV.fetch('VERSION_CODE')}",
      output_directory: "build",
    )
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
